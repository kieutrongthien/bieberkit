# Dependencies and build output
node_modules/
dist/
.turbo/
coverage/
*.tsbuildinfo

# Git worktrees created by the Superpowers workflow
.worktrees/

# Generated per project or per run
.bieberkit/
playwright-report/
test-results/

# Secrets. Only the example file is committed.
.env
.env.*
!.env.example

# Local agent and editor settings
.claude/settings.local.json
.gemini/.env
.idea/
.vscode/*
!.vscode/extensions.json

# OS and logs
.DS_Store
Thumbs.db
*.log

# Scratch folders of tests (the bundle size test builds here and removes it)
.tmp/
