{
  "name": "@bieberkit/plugin-media",
  "version": "0.0.0",
  "private": true,
  "description": "Media records for files in the storage: a name, a type, a size and a state, confirmed after the upload.",
  "keywords": [
    "bieberkit",
    "bieberkit-plugin"
  ],
  "license": "Apache-2.0",
  "author": "Bieber Kieu <kieutrongthien@gmail.com>",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@bieberkit/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsdown && node --conditions=@bieberkit/source ../../tools/plugin-manifests.ts --write --plugin .",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@bieberkit/core": "workspace:*",
    "@bieberkit/data": "workspace:*",
    "@bieberkit/http": "workspace:*",
    "@bieberkit/storage": "workspace:*"
  },
  "devDependencies": {
    "@bieberkit/testing": "workspace:*"
  },
  "engines": {
    "node": ">=24.12"
  },
  "bieberkit": {
    "core": "*",
    "dialects": [
      "mysql",
      "postgres",
      "sqlite"
    ],
    "requires": {},
    "conflicts": [],
    "env": [],
    "tables": [
      "bk_media"
    ],
    "routes": [
      "POST /api/v1/media/media/:id/confirm",
      "POST /api/v1/media/media/:id/upload-url"
    ],
    "permissions": [
      "media.manage",
      "media.read",
      "media.upload"
    ],
    "admin": []
  }
}
