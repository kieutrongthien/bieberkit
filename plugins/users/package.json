{
  "name": "@bieberkit/plugin-users",
  "version": "0.2.0",
  "description": "The users of the application: a list, an invitation with a password, and the administrator account of the seed.",
  "keywords": [
    "bieberkit",
    "bieberkit-plugin"
  ],
  "homepage": "https://github.com/kieutrongthien/bieberkit#readme",
  "bugs": {
    "url": "https://github.com/kieutrongthien/bieberkit/issues"
  },
  "license": "Apache-2.0",
  "author": "Bieber Kieu <kieutrongthien@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kieutrongthien/bieberkit.git",
    "directory": "plugins/users"
  },
  "files": [
    "dist",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@bieberkit/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsdown && node --conditions=@bieberkit/source ../../tools/plugin-manifests.ts --write --plugin .",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@bieberkit/auth": "workspace:*",
    "@bieberkit/core": "workspace:*",
    "@bieberkit/data": "workspace:*",
    "@bieberkit/http": "workspace:*"
  },
  "devDependencies": {
    "@bieberkit/plugin-roles": "workspace:*",
    "@bieberkit/testing": "workspace:*"
  },
  "engines": {
    "node": ">=24.12"
  },
  "bieberkit": {
    "core": "*",
    "dialects": [
      "mysql",
      "postgres",
      "sqlite"
    ],
    "requires": {
      "@bieberkit/plugin-roles": "*"
    },
    "conflicts": [],
    "env": [
      "USERS_ADMIN_EMAIL",
      "USERS_ADMIN_PASSWORD",
      "USERS_INVITE_TTL_DAYS"
    ],
    "tables": [],
    "routes": [
      "DELETE /api/v1/users/users/:id",
      "DELETE /api/v1/users/users/:id/sessions",
      "DELETE /api/v1/users/users/:id/sessions/:sessionId",
      "GET /api/v1/users/me",
      "GET /api/v1/users/users",
      "GET /api/v1/users/users/:id",
      "GET /api/v1/users/users/:id/permissions",
      "GET /api/v1/users/users/:id/sessions",
      "PATCH /api/v1/users/me",
      "PATCH /api/v1/users/users/:id",
      "POST /api/v1/users/users",
      "POST /api/v1/users/users/:id/disable",
      "POST /api/v1/users/users/:id/enable",
      "POST /api/v1/users/users/:id/mfa/reset",
      "POST /api/v1/users/users/:id/resend-invite",
      "POST /api/v1/users/users/:id/reset-password",
      "PUT /api/v1/users/users/:id/groups"
    ],
    "permissions": [
      "users.manage",
      "users.override-external",
      "users.read",
      "users.reset-mfa",
      "users.revoke-sessions"
    ],
    "admin": []
  }
}
