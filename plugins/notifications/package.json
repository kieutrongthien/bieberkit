{
  "name": "@bieberkit/plugin-notifications",
  "version": "0.3.0",
  "description": "Notifications for a user: a title, a text and a read time, with the read-own permission.",
  "keywords": [
    "bieberkit",
    "bieberkit-plugin"
  ],
  "homepage": "https://github.com/kieutrongthien/bieberkit#readme",
  "bugs": {
    "url": "https://github.com/kieutrongthien/bieberkit/issues"
  },
  "license": "Apache-2.0",
  "author": "Bieber Kieu <kieutrongthien@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kieutrongthien/bieberkit.git",
    "directory": "plugins/notifications"
  },
  "files": [
    "dist",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@bieberkit/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsdown && node --conditions=@bieberkit/source ../../tools/plugin-manifests.ts --write --plugin .",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@bieberkit/auth": "workspace:*",
    "@bieberkit/core": "workspace:*",
    "@bieberkit/data": "workspace:*",
    "@bieberkit/http": "workspace:*",
    "@bieberkit/mail": "workspace:*",
    "@bieberkit/queue": "workspace:*",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@bieberkit/testing": "workspace:*"
  },
  "engines": {
    "node": ">=24.12"
  },
  "bieberkit": {
    "core": "*",
    "dialects": [
      "mysql",
      "postgres",
      "sqlite"
    ],
    "requires": {},
    "conflicts": [],
    "env": [
      "NOTIFICATIONS_RETENTION_DAYS"
    ],
    "tables": [
      "bk_notification_preferences",
      "bk_notifications"
    ],
    "routes": [
      "DELETE /api/v1/notifications/me/:id",
      "GET /api/v1/notifications/me",
      "GET /api/v1/notifications/me/preferences",
      "GET /api/v1/notifications/me/unread-count",
      "POST /api/v1/notifications/me/:id/read",
      "POST /api/v1/notifications/me/read-all",
      "POST /api/v1/notifications/send",
      "PUT /api/v1/notifications/me/preferences"
    ],
    "permissions": [
      "notifications.manage",
      "notifications.read",
      "notifications.send"
    ],
    "admin": []
  }
}
