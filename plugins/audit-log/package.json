{
  "name": "@bieberkit/plugin-audit-log",
  "version": "0.4.0",
  "description": "Read access to the audit log of the application: who did what, when, with the filters of an investigation.",
  "keywords": [
    "bieberkit",
    "bieberkit-plugin"
  ],
  "homepage": "https://github.com/kieutrongthien/bieberkit#readme",
  "bugs": {
    "url": "https://github.com/kieutrongthien/bieberkit/issues"
  },
  "license": "Apache-2.0",
  "author": "Bieber Kieu <kieutrongthien@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kieutrongthien/bieberkit.git",
    "directory": "plugins/audit-log"
  },
  "files": [
    "dist",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@bieberkit/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./admin": {
      "@bieberkit/source": "./src/admin/index.ts",
      "types": "./dist/admin/index.d.ts",
      "default": "./dist/admin/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./admin": {
        "types": "./dist/admin/index.d.ts",
        "default": "./dist/admin/index.js"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsdown && tsdown -c tsdown.admin.config.ts && node --conditions=@bieberkit/source ../../tools/plugin-manifests.ts --write --plugin .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p src/admin/tsconfig.json"
  },
  "dependencies": {
    "@bieberkit/auth": "workspace:*",
    "@bieberkit/cache": "workspace:*",
    "@bieberkit/core": "workspace:*",
    "@bieberkit/data": "workspace:*",
    "@bieberkit/http": "workspace:*",
    "@bieberkit/queue": "workspace:*",
    "@mikro-orm/core": "7.2.9",
    "@mikro-orm/sql": "7.2.9",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@bieberkit/admin-antd": "workspace:*",
    "@bieberkit/admin-core": "workspace:*",
    "@bieberkit/testing": "workspace:*",
    "@tanstack/react-query": "5.108.0",
    "@types/react": "19.3.0",
    "antd": "6.7.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "peerDependencies": {
    "@bieberkit/admin-antd": "workspace:^",
    "@bieberkit/admin-core": "workspace:^",
    "@tanstack/react-query": "^5.108.0",
    "antd": "^6.0.0",
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "@bieberkit/admin-antd": {
      "optional": true
    },
    "@bieberkit/admin-core": {
      "optional": true
    },
    "@tanstack/react-query": {
      "optional": true
    },
    "antd": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24.12"
  },
  "bieberkit": {
    "core": "*",
    "dialects": [
      "mysql",
      "postgres",
      "sqlite"
    ],
    "requires": {},
    "conflicts": [],
    "env": [
      "AUDIT_LOG_EXPORT_MAX_ROWS",
      "AUDIT_LOG_MIRROR"
    ],
    "tables": [],
    "routes": [
      "DELETE /api/v1/audit-log/holds/:id",
      "GET /api/v1/audit-log/actions",
      "GET /api/v1/audit-log/entries",
      "GET /api/v1/audit-log/entries/:id",
      "GET /api/v1/audit-log/export",
      "GET /api/v1/audit-log/holds",
      "POST /api/v1/audit-log/holds"
    ],
    "permissions": [
      "audit-log.export",
      "audit-log.hold",
      "audit-log.read"
    ],
    "admin": []
  }
}
