{
  "name": "@bieberkit/plugin-audit-log",
  "version": "0.1.0",
  "description": "Read access to the audit log of the application: who did what, when, with the filters of an investigation.",
  "keywords": [
    "bieberkit",
    "bieberkit-plugin"
  ],
  "homepage": "https://github.com/kieutrongthien/bieberkit#readme",
  "bugs": {
    "url": "https://github.com/kieutrongthien/bieberkit/issues"
  },
  "license": "Apache-2.0",
  "author": "Bieber Kieu <kieutrongthien@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kieutrongthien/bieberkit.git",
    "directory": "plugins/audit-log"
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@bieberkit/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsdown && node --conditions=@bieberkit/source ../../tools/plugin-manifests.ts --write --plugin .",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@bieberkit/core": "workspace:*",
    "@bieberkit/data": "workspace:*",
    "@bieberkit/http": "workspace:*"
  },
  "devDependencies": {
    "@bieberkit/testing": "workspace:*"
  },
  "engines": {
    "node": ">=24.12"
  },
  "bieberkit": {
    "core": "*",
    "dialects": [
      "mysql",
      "postgres",
      "sqlite"
    ],
    "requires": {},
    "conflicts": [],
    "env": [],
    "tables": [],
    "routes": [
      "GET /api/v1/audit-log/entries"
    ],
    "permissions": [
      "audit-log.read"
    ],
    "admin": []
  }
}
