{
  "name": "@bieberkit/plugin-roles",
  "version": "0.4.1",
  "description": "Roles and their permissions: the list, the permission catalogue, create, change, assign, and the base roles of the seed.",
  "keywords": [
    "bieberkit",
    "bieberkit-plugin"
  ],
  "homepage": "https://github.com/kieutrongthien/bieberkit#readme",
  "bugs": {
    "url": "https://github.com/kieutrongthien/bieberkit/issues"
  },
  "license": "Apache-2.0",
  "author": "Bieber Kieu <kieutrongthien@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kieutrongthien/bieberkit.git",
    "directory": "plugins/roles"
  },
  "files": [
    "dist",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@bieberkit/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsdown && node --conditions=@bieberkit/source ../../tools/plugin-manifests.ts --write --plugin .",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@bieberkit/auth": "workspace:*",
    "@bieberkit/core": "workspace:*",
    "@bieberkit/data": "workspace:*",
    "@bieberkit/http": "workspace:*"
  },
  "devDependencies": {
    "@bieberkit/testing": "workspace:*"
  },
  "engines": {
    "node": ">=24.12"
  },
  "bieberkit": {
    "core": "*",
    "dialects": [
      "mysql",
      "postgres",
      "sqlite"
    ],
    "requires": {},
    "conflicts": [],
    "env": [],
    "tables": [],
    "routes": [
      "DELETE /api/v1/roles/roles/:id",
      "GET /api/v1/roles/permissions",
      "GET /api/v1/roles/roles",
      "GET /api/v1/roles/roles/:id",
      "GET /api/v1/roles/roles/:id/members",
      "PATCH /api/v1/roles/roles/:id",
      "POST /api/v1/roles/roles",
      "POST /api/v1/roles/roles/:id/assign",
      "POST /api/v1/roles/roles/:id/duplicate",
      "POST /api/v1/roles/roles/:id/revoke"
    ],
    "permissions": [
      "roles.manage",
      "roles.read"
    ],
    "admin": []
  }
}
