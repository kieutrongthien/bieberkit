set -eu

# GOV-03: every commit carries a Developer Certificate of Origin sign-off.
if ! grep -q '^Signed-off-by: .\+ <.\+@.\+>' "$1"; then
  echo "commit-msg: missing DCO sign-off." >&2
  echo "    Fix: commit with git commit -s (or git commit --amend -s --no-edit)." >&2
  exit 1
fi
