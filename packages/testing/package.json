{
  "name": "@bieberkit/testing",
  "version": "0.4.0",
  "description": "Test app, entity factories, callers with roles and tenants, and the helpers that run a suite on every dialect.",
  "keywords": [
    "bieberkit"
  ],
  "homepage": "https://github.com/kieutrongthien/bieberkit#readme",
  "bugs": {
    "url": "https://github.com/kieutrongthien/bieberkit/issues"
  },
  "license": "Apache-2.0",
  "author": "Bieber Kieu <kieutrongthien@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kieutrongthien/bieberkit.git",
    "directory": "packages/testing"
  },
  "files": [
    "dist",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@bieberkit/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@bieberkit/auth": "workspace:*",
    "@bieberkit/cache": "workspace:*",
    "@bieberkit/core": "workspace:*",
    "@bieberkit/data": "workspace:*",
    "@bieberkit/http": "workspace:*",
    "@bieberkit/mail": "workspace:*",
    "@bieberkit/queue": "workspace:*",
    "@bieberkit/storage": "workspace:*"
  },
  "devDependencies": {
    "@bieberkit/admin-core": "workspace:*",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=24.12"
  }
}
