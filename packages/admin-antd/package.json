{
  "name": "@bieberkit/admin-antd",
  "version": "0.4.1",
  "description": "The Ant Design shell of the admin: the frame, the generic list and form, and the slots of the admin parts of plugins. A project builds its admin from it.",
  "keywords": [
    "bieberkit"
  ],
  "homepage": "https://github.com/kieutrongthien/bieberkit#readme",
  "bugs": {
    "url": "https://github.com/kieutrongthien/bieberkit/issues"
  },
  "license": "Apache-2.0",
  "author": "Bieber Kieu <kieutrongthien@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kieutrongthien/bieberkit.git",
    "directory": "packages/admin-antd"
  },
  "files": [
    "dist",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "@bieberkit/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@bieberkit/admin-core": "workspace:*",
    "@bieberkit/tokens": "workspace:*",
    "@fontsource/be-vietnam-pro": "5.3.0",
    "@tanstack/react-query": "5.108.0",
    "@tanstack/react-router": "1.170.46",
    "antd": "6.7.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "vite": "8.3.8"
  },
  "engines": {
    "node": ">=24.12"
  }
}
