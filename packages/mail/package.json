{
  "name": "@bieberkit/mail",
  "version": "0.2.0",
  "description": "Mail contract and drivers.",
  "keywords": [
    "bieberkit"
  ],
  "homepage": "https://github.com/kieutrongthien/bieberkit#readme",
  "bugs": {
    "url": "https://github.com/kieutrongthien/bieberkit/issues"
  },
  "license": "Apache-2.0",
  "author": "Bieber Kieu <kieutrongthien@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kieutrongthien/bieberkit.git",
    "directory": "packages/mail"
  },
  "files": [
    "dist",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@bieberkit/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./nodemailer": {
      "@bieberkit/source": "./src/adapters/nodemailer/index.ts",
      "types": "./dist/nodemailer.d.ts",
      "default": "./dist/nodemailer.js"
    },
    "./testing": {
      "@bieberkit/source": "./src/testing/index.ts",
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./nodemailer": {
        "types": "./dist/nodemailer.d.ts",
        "default": "./dist/nodemailer.js"
      },
      "./testing": {
        "types": "./dist/testing.d.ts",
        "default": "./dist/testing.js"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@bieberkit/core": "workspace:*",
    "@bieberkit/queue": "workspace:*",
    "nodemailer": "10.6.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/nodemailer": "8.0.2"
  },
  "engines": {
    "node": ">=24.12"
  }
}
