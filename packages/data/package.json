{
  "name": "@bieberkit/data",
  "version": "0.0.0",
  "private": true,
  "description": "defineEntity, MikroORM integration and migrations.",
  "keywords": [
    "bieberkit"
  ],
  "license": "Apache-2.0",
  "author": "Bieber Kieu <kieutrongthien@gmail.com>",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@bieberkit/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./orm": {
      "@bieberkit/source": "./src/orm/index.ts",
      "types": "./dist/orm.d.ts",
      "default": "./dist/orm.js"
    },
    "./schema": {
      "@bieberkit/source": "./src/schema/index.ts",
      "types": "./dist/schema.d.ts",
      "default": "./dist/schema.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./orm": {
        "types": "./dist/orm.d.ts",
        "default": "./dist/orm.js"
      },
      "./schema": {
        "types": "./dist/schema.d.ts",
        "default": "./dist/schema.js"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@bieberkit/core": "workspace:*",
    "@mikro-orm/core": "7.2.9",
    "@mikro-orm/mysql": "7.2.9",
    "@mikro-orm/postgresql": "7.2.9",
    "@mikro-orm/sql": "7.2.9",
    "@mikro-orm/sqlite": "7.2.9",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "better-sqlite3": "13.0.3",
    "kysely": "0.29.8",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "rolldown": "1.3.2"
  },
  "engines": {
    "node": ">=24.12"
  }
}
