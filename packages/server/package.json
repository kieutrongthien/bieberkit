{
  "name": "@bieberkit/server",
  "version": "0.3.0",
  "description": "Boot of the process roles: web, worker, scheduler and migrate.",
  "keywords": [
    "bieberkit"
  ],
  "homepage": "https://github.com/kieutrongthien/bieberkit#readme",
  "bugs": {
    "url": "https://github.com/kieutrongthien/bieberkit/issues"
  },
  "license": "Apache-2.0",
  "author": "Bieber Kieu <kieutrongthien@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kieutrongthien/bieberkit.git",
    "directory": "packages/server"
  },
  "files": [
    "dist",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@bieberkit/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./plugins": {
      "@bieberkit/source": "./src/plugins.ts",
      "types": "./dist/plugins.d.ts",
      "default": "./dist/plugins.js"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json",
      "./plugins": {
        "types": "./dist/plugins.d.ts",
        "default": "./dist/plugins.js"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@bieberkit/auth": "workspace:*",
    "@bieberkit/cache": "workspace:*",
    "@bieberkit/core": "workspace:*",
    "@bieberkit/data": "workspace:*",
    "@bieberkit/http": "workspace:*",
    "@bieberkit/log": "workspace:*",
    "@bieberkit/mail": "workspace:*",
    "@bieberkit/queue": "workspace:*",
    "@bieberkit/storage": "workspace:*",
    "@bieberkit/tokens": "workspace:*"
  },
  "engines": {
    "node": ">=24.12"
  }
}
