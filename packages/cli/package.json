{
  "name": "bieberkit",
  "version": "0.4.0",
  "description": "The bieberkit project CLI.",
  "keywords": [
    "bieberkit"
  ],
  "homepage": "https://github.com/kieutrongthien/bieberkit#readme",
  "bugs": {
    "url": "https://github.com/kieutrongthien/bieberkit/issues"
  },
  "license": "Apache-2.0",
  "author": "Bieber Kieu <kieutrongthien@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kieutrongthien/bieberkit.git",
    "directory": "packages/cli"
  },
  "bin": {
    "bieberkit": "./dist/bin.js"
  },
  "files": [
    "dist",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@bieberkit/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./admin-vite": {
      "@bieberkit/source": "./src/admin-vite.ts",
      "types": "./dist/admin-vite.d.ts",
      "default": "./dist/admin-vite.js"
    },
    "./oxlint": {
      "@bieberkit/source": "./src/oxlint.ts",
      "types": "./dist/oxlint.d.ts",
      "default": "./dist/oxlint.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./admin-vite": {
        "types": "./dist/admin-vite.d.ts",
        "default": "./dist/admin-vite.js"
      },
      "./oxlint": {
        "types": "./dist/oxlint.d.ts",
        "default": "./dist/oxlint.js"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@bieberkit/admin-core": "workspace:*",
    "@bieberkit/auth": "workspace:*",
    "@bieberkit/core": "workspace:*",
    "@bieberkit/data": "workspace:*",
    "@bieberkit/http": "workspace:*",
    "@bieberkit/queue": "workspace:*",
    "@bieberkit/server": "workspace:*",
    "create-bieberkit": "workspace:*"
  },
  "devDependencies": {
    "vite": "8.3.8"
  },
  "peerDependencies": {
    "vite": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24.12"
  }
}
