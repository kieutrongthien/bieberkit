{
  "name": "bieberkit",
  "version": "0.0.0",
  "private": true,
  "description": "The bieberkit project CLI.",
  "keywords": [
    "bieberkit"
  ],
  "license": "Apache-2.0",
  "author": "Bieber Kieu <kieutrongthien@gmail.com>",
  "bin": {
    "bieberkit": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@bieberkit/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./oxlint": {
      "@bieberkit/source": "./src/oxlint.ts",
      "types": "./dist/oxlint.d.ts",
      "default": "./dist/oxlint.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./oxlint": {
        "types": "./dist/oxlint.d.ts",
        "default": "./dist/oxlint.js"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@bieberkit/core": "workspace:*",
    "@bieberkit/data": "workspace:*",
    "@bieberkit/http": "workspace:*",
    "@bieberkit/queue": "workspace:*",
    "@bieberkit/server": "workspace:*",
    "create-bieberkit": "workspace:*"
  },
  "engines": {
    "node": ">=24.12"
  }
}
