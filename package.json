{
  "name": "bieberkit-monorepo",
  "version": "0.3.0",
  "private": true,
  "description": "BieberKit framework monorepo.",
  "license": "Apache-2.0",
  "author": "Bieber Kieu <kieutrongthien@gmail.com>",
  "type": "module",
  "scripts": {
    "build": "pnpm manifests:write && turbo run build",
    "typecheck": "turbo run typecheck && tsc --noEmit -p tsconfig.json && tsc --noEmit -p e2e/fixtures/crm/tsconfig.json",
    "lint": "oxlint --type-aware",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "pnpm check:headers && pnpm check:layers && pnpm check:env-access && pnpm check:skills && pnpm check:workflows && pnpm check:manifests && pnpm check:shared-admin",
    "check:headers": "node tools/check-headers.ts",
    "check:layers": "node tools/check-layers.ts",
    "check:env-access": "node tools/check-env-access.ts",
    "check:skills": "node tools/sync-skills.ts --check",
    "check:workflows": "node tools/check-workflows.ts",
    "check:shared-admin": "node tools/check-shared-admin.ts",
    "check:api": "node tools/api-report.ts",
    "api:update": "node tools/api-report.ts --write",
    "check:changeset": "node tools/api-report.ts --changeset-since origin/main",
    "check:packages": "node tools/check-packages.ts",
    "sync:skills": "node tools/sync-skills.ts",
    "changeset": "changeset",
    "test:acceptance": "node tools/acceptance/plugin-author.mjs",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "bench": "node benchmarks/run.mjs",
    "manifests:write": "node --conditions=@bieberkit/source tools/plugin-manifests.ts --write",
    "check:manifests": "node --conditions=@bieberkit/source tools/plugin-manifests.ts",
    "test:artifacts": "vitest run --config vitest.artifacts.config.ts",
    "check:admin-size": "node tools/check-admin-size.ts"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@axe-core/playwright": "4.14.0",
    "@changesets/cli": "3.0.3",
    "@playwright/test": "1.65.1",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "4.1.12",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2007",
    "publint": "0.3.25",
    "tsdown": "0.23.7",
    "turbo": "^2.11.11",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12",
    "yaml": "2.9.1"
  },
  "engines": {
    "node": ">=24.12",
    "pnpm": ">=12"
  },
  "packageManager": "pnpm@12.21.0"
}
